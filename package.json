{
  "name": "obsidian-public-render",
  "version": "1.3.0",
  "private": true,
  "description": "Publish individual notes from a private Obsidian vault to unguessable public URLs.",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/build",
    "packages/worker",
    "packages/plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/shared packages/build packages/worker packages/plugin",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish:notes": "npm run start -w @notes/build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
