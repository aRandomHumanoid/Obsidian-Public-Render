{
  "name": "@notes/worker",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@notes/shared": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "wrangler": "^4.123.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
