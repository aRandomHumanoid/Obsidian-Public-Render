{
  "name": "@notes/build",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "bin": {
    "notes-publish": "./dist/cli.js",
    "notes-preview": "./dist/preview.js"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node --experimental-strip-types src/cli.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "preview": "node dist/preview.js"
  },
  "dependencies": {
    "@notes/shared": "*",
    "@shikijs/rehype": "^1.24.2",
    "dompurify": "^3.4.13",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "jsdom": "^25.0.1",
    "katex": "^0.16.15",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "sharp": "^0.35.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "yaml": "^2.6.1",
    "@notes/worker": "*"
  },
  "optionalDependencies": {
    "@mermaid-js/mermaid-cli": "^11.4.2"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/jsdom": "^21.1.7",
    "@types/mdast": "^4.0.4"
  }
}
